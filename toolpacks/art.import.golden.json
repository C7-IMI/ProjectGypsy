{
  "schema": "gypsy.toolpack/v1",
  "id": "art.import.golden",
  "name": "Blender golden kit -> Godot import",
  "tools": [
    "Blender 5.2.3 LTS",
    "Godot 4.7.2",
    "Python 3.14",
    "glTF-Validator"
  ],
  "license": "Blender GPL-3.0-or-later; Godot MIT; generated golden assets are test-only, no third-party art",
  "actions": [
    {
      "id": "import",
      "argv": [
        "python",
        "scripts/import_matrix.py"
      ],
      "cwd": ".",
      "timeout": 900,
      "artifacts": [
        "workstream/state/import-matrix.json",
        "docs/IMPORT-MATRIX.md"
      ],
      "args": {
        "note": "regenerates the golden kit, round-trips GLB/FBX, validates glTF and imports into Godot"
      }
    }
  ],
  "validators": [
    {
      "id": "godot-pass",
      "kind": "json",
      "artifact": "workstream/state/import-matrix.json",
      "checks": [
        {
          "path": "godot.status",
          "equals": "pass"
        },
        {
          "path": "godot.results.rigged_character.animations",
          "gte": 3
        },
        {
          "path": "godot.results.lod_set.meshes",
          "gte": 4
        }
      ]
    },
    {
      "id": "matrix-doc",
      "kind": "text",
      "artifact": "docs/IMPORT-MATRIX.md",
      "contains": "4.7.2"
    }
  ]
}
