; ProjectGypsy — Phase-1 vertical slice. Engine: Godot 4.7.2 (pinned in project.gypsy.json).
; The slice is intentionally small: one 3D scene, one mechanic (collect 3 crystals),
; one scripted headless demo. Interface design is parked (ProjectPack PG-D4), so there is no HUD.
config_version=5

[application]

config/name="ProjectGypsy"
config/description="Phase-1 vertical slice: walk, jump, collect three crystals. Deterministic headless demo via '-- --demo'."
config/icon="res://icon.svg"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
run/flush_stdout_on_print=true

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[physics]

common/physics_ticks_per_second=60

[rendering]

textures/vram_compression/import_etc2_astc=true

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
