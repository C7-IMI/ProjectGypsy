{
  "schema": "gypsy.toolpack/v1",
  "id": "mobile.android",
  "name": "Godot Android debug APK",
  "tools": [
    "Godot 4.7.2",
    "OpenJDK 17",
    "Android SDK 35 / build-tools 35.0.0",
    "PowerShell 5.1"
  ],
  "license": "Godot MIT; OpenJDK GPL-2.0-with-classpath-exception; Android SDK terms; debug keystore local",
  "actions": [
    {
      "id": "build",
      "argv": [
        "powershell",
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "scripts/build_android.ps1"
      ],
      "cwd": ".",
      "timeout": 900,
      "artifacts": [
        "build/ProjectGypsy.apk"
      ],
      "args": {
        "note": "headless Android export, debug keystore, aapt2 badging and apksigner verification"
      }
    }
  ],
  "validators": [
    {
      "id": "apk-size",
      "kind": "file",
      "artifact": "build/ProjectGypsy.apk",
      "minBytes": 20000000
    }
  ]
}
