{
  "schema": "gypsy.capability/v1",
  "id": "engine.unity.build",
  "layer": "engine",
  "engine": "unity",
  "kind": "build",
  "maturity": "planned",
  "description": "Unity batchmode build. Licence is proven via smoke; the project adapter/build harness is not yet built.",
  "requires": [
    "unity.installed",
    "unity.licence"
  ],
  "inputs": [
    {
      "name": "project",
      "type": "path"
    },
    {
      "name": "target",
      "type": "string"
    }
  ],
  "outputs": [
    {
      "name": "build",
      "type": "directory"
    },
    {
      "name": "log",
      "type": "file"
    }
  ],
  "checks": [
    "batchmode exits 0",
    "licence was proven before the run",
    "output exists"
  ],
  "provenance": {
    "record": [
      "engine.version",
      "target",
      "command",
      "exitCode",
      "logHash"
    ]
  }
}
