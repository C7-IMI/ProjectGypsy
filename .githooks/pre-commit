#!/bin/sh
# ProjectGypsy pre-commit hook (ProjectPack rule 2.23).
#
# This file is tracked in the repository; scripts/install-hooks.py points git at this directory
# with core.hooksPath, so the hook is versioned with the code instead of a machine's .git/hooks.
# It is a convenience, not the gate: .github/workflows/checks.yml runs the same one check list
# and cannot be bypassed with --no-verify.
#
# The list itself is scripts/check_all.py - add a check there, not here.
set -eu

cd "$(git rev-parse --show-toplevel)"
exec python scripts/check_all.py
